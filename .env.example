RESTART=unless-stopped
TZ=Africa/Bujumbura

# Pinned to what ran before the move to upstream's compose file. Remove it
#   to follow the default in docker-compose.yml.
VERSION=7.1.2-0004
# Must stay on 8.x until the VM's CPU supports x86-64-v2, see docker-compose.override.yml.
ELASTICSEARCH_VERSION=8.19.4

ZAMMAD_FQDN=support.focusfinance.bi
ZAMMAD_HTTP_TYPE=https
NGINX_SERVER_NAME=support.focusfinance.bi
NGINX_SERVER_SCHEME=https
NGINX_CLIENT_MAX_BODY_SIZE=50m

POSTGRES_DB=zammad_production
POSTGRES_USER=zammad
POSTGRES_PASS=
